c;strokeColor=#d6b656;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="7548" width="230" height="56" as="geometry"/></mxCell><mxCell id="v548" value="Детские → Эко → остальные&lt;br&gt;каждое, если ≥ порога&lt;br&gt;затем размер 6–18" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="7548" width="230" height="58" as="geometry"/></mxCell><mxCell id="e549" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="v547" target="v548"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e550" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="v530" target="v547"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e551" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="v487" target="v530"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e552" style="edgeStyle=entityRelationEdgeStyle;curved=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="v2" target="v487"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v553" value="Вход" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="20" width="230" height="36" as="geometry"/></mxCell><mxCell id="v554" value="1. Бренд&lt;br&gt;(жёстко)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="230" height="36" as="geometry"/></mxCell><mxCell id="v555" value="2. Тип товара&lt;br&gt;(жёстко)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="20" width="230" height="36" as="geometry"/></mxCell><mxCell id="v556" value="3. Признак типа&lt;br&gt;(по порогу)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="900" y="20" width="230" height="36" as="geometry"/></mxCell><mxCell id="v557" value="4. Итог: детские, эко, размер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="20" width="230" height="36" as="geometry"/></mxCell><mxCell id="v558" value="Как читать: цвет ветки — бренд. Сплошная рамка — жёсткое деление (бренд, тип), пунктир — деление по порогу: подгруппа отделяется, только если в ней достаточно дизайнов (Озон: 6), иначе остаётся в родителе. Красный — не склеиваем. Бельё (комплект, пододеяльник, простыня, наволочка) показано у каждого бренда; остальные типы — у Сказки, у других брендов они добавятся, если появятся такие товары." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="-80" width="1480" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>