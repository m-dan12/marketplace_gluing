<mxfile host="app.diagrams.net"><diagram id="p0" name="1. Общая схема Озон"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="Карточки Озона с остатком&lt;br&gt;FBO + FBS &gt; 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="126" width="230" height="52" as="geometry"/></mxCell><mxCell id="v3" value="1. Бренд — жёстко&lt;br&gt;по префиксу артикула" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="126" width="230" height="52" as="geometry"/></mxCell><mxCell id="v4" value="2. Тип товара — жёстко&lt;br&gt;из карточки Озона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="126" width="230" height="52" as="geometry"/></mxCell><mxCell id="v5" value="3. Признаки типа&lt;br&gt;по порогу" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="126" width="230" height="52" as="geometry"/></mxCell><mxCell id="v6" value="4. Детские / эко&lt;br&gt;по порогу, только бельё" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1400" y="126" width="230" height="52" as="geometry"/></mxCell><mxCell id="v7" value="5. Размер группы&lt;br&gt;6–18 дизайнов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1750" y="126" width="230" height="52" as="geometry"/></mxCell><mxCell id="v8" value="Склейка&lt;br&gt;6–18 дизайнов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2100" y="60" width="230" height="46" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v10" value="Больше 18 дизайнов →&lt;br&gt;делим на равные части&lt;br&gt;(поровну и по силе, веером)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2100" y="124" width="230" height="60" as="geometry"/></mxCell><mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v12" value="Меньше 6 дизайнов →&lt;br&gt;список «слишком мало»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2100" y="192" width="230" height="46" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v7" target="v12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v19" value="Бренды (жёстко, по префиксу):&lt;br&gt;Сказка — PT (и опечатка РТ), GR, OK&lt;br&gt;Мечта — MT&lt;br&gt;Анна Мария — AM&lt;br&gt;Анна Мария — PA (отдельно от AM)&lt;br&gt;Сказка Сатин — PC&lt;br&gt;Milky Garden — MY, MI, KK&lt;br&gt;Timeless — без префикса" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="330" width="360" height="150" as="geometry"/></mxCell><mxCell id="v20" value="Правило порога: признак отделяется, только если получившаяся подгруппа ≥ порога (Озон: 6 дизайнов, WB: 10 SKU). Иначе она остаётся в «обычных», а когда товаров станет больше — отделится сама." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="330" width="380" height="110" as="geometry"/></mxCell><mxCell id="v21" value="Почему тип и бренд жёсткие: Озон склеивает только товары одного типа и бренда (так сказано в ozon_skleyki.py). Типы и бренды не смешиваем." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="330" width="380" height="100" as="geometry"/></mxCell><mxCell id="v22" value="Цвета: серый — вход, синий — жёсткий уровень, зелёный — мягкий (по порогу), жёлтый — склейка, красный — не склеиваем" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="900" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2. Постельное бельё"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="Постельное бельё&lt;br&gt;(типы товара внутри бренда)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="230" height="52" as="geometry"/></mxCell><mxCell id="v3" value="Комплект постельного белья" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="158" width="230" height="46" as="geometry"/></mxCell><mxCell id="v4" value="Обычные&lt;br&gt;→ затем блок «Детские / эко»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="90" width="230" height="60" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v6" value="Рюши&lt;br&gt;(17, 18 Сказка; 19 Timeless)&lt;br&gt;если мало → в «Обычные»&lt;br&gt;→ затем блок «Детские / эко»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="158" width="230" height="60" as="geometry"/></mxCell><mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v8" value="Ромбы&lt;br&gt;если мало → в «Обычные»&lt;br&gt;→ затем блок «Детские / эко»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="226" width="230" height="60" as="geometry"/></mxCell><mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v3" target="v8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v11" value="Пододеяльник" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="362" width="230" height="46" as="geometry"/></mxCell><mxCell id="v12" value="Обычные (на молнии)&lt;br&gt;→ затем блок «Детские / эко»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="294" width="230" height="60" as="geometry"/></mxCell><mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;" edge="1" parent="1" so