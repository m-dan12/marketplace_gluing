        "url": {
          "raw": "{{base}}/v1/description-category/attribute",
          "host": [
            "{{base}}"
          ],
          "path": [
            "v1",
            "description-category",
            "attribute"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description_category_id\": 17028731,\n  \"type_id\": 92603,\n  \"language\": \"DEFAULT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Список атрибутов типа «Комплект постельного белья» (category 17028731, type 92603); скрипт показывает только атрибут 85."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const attr = (pm.response.json().result || []).find(a => a.id === 85);",
              "pm.visualizer.set(`<pre>{{json}}</pre>`, {json: JSON.stringify(attr, null, 2)});",
              "console.log(\"Атрибут 85 (Бренд):\", attr);"
            ]
          }
        }
      ],
      "response": [
