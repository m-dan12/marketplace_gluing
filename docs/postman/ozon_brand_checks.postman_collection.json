          "body": "{\n  \"result\": [\n    {\n      \"id\": 85,\n      \"name\": \"Бренд\",\n      \"is_required\": true,\n      \"is_aspect\": false,\n      \"category_dependent\": true,\n      \"dictionary_id\": 28732849,\n      \"max_value_count\": 0,\n      \"type\": \"String\"\n    }\n  ]\n}"
        }
